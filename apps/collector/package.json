{
  "name": "@quantedge/collector",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "seed": "node --env-file=../../.env src/seed.ts",
    "bench:latency": "node src/bench-latency.ts",
    "dev": "node --env-file=../../.env --watch src/index.ts",
    "start": "node src/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@quantedge/db": "workspace:*",
    "@quantedge/shared": "workspace:*",
    "@quantedge/venue": "workspace:*",
    "drizzle-orm": "0.45.2",
    "pino": "10.3.1",
    "postgres": "3.4.9",
    "zod": "4.6.2"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
