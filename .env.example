# Postgres. Two connection strings, and they are not interchangeable:
#   DATABASE_URL         — runtime, transaction pooler, port 6543
#   DATABASE_URL_MIGRATE — drizzle-kit migrations, session pooler, port 5432
# Supabase's direct 5432 connection is IPv6-only and does not come up from Windows.
DATABASE_URL=postgresql://postgres.<ref>:<password>@<host>:6543/postgres
DATABASE_URL_MIGRATE=postgresql://postgres.<ref>:<password>@<host>:5432/postgres

# Two INDEPENDENT providers — this is the instrument, not redundancy (FR-003c).
# The difference in arrival time of the same state between them is the latency measurement.
# A single provider makes the product's core measurement impossible.
RPC_A_NAME=
RPC_A_WS_URL=wss://<provider-a>/?api-key=<key>
RPC_B_NAME=
RPC_B_WS_URL=wss://<provider-b>/?api-key=<key>

# Manifest market whose book we record (market account address).
MARKET_ADDRESS=

# How many book levels per side we store. Affects the SC-006 budget.
BOOK_DEPTH=15

PORT=8879
LOG_LEVEL=info
