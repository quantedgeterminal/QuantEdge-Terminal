{
  "name": "quantedge-terminal",
  "version": "0.0.0",
  "private": true,
  "description": "A terminal that measures the cost of market-data latency on historical Solana order books",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "check": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "pnpm -r typecheck",
    "gate": "pnpm check && pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@types/node": "22.20.2",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
